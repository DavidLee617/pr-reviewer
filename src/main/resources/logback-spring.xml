<?xml version="1.0" encoding="UTF-8"?>
<!--
  所有日志写 stderr：
  - CLI 模式下 stdout 只留给进度和汇总输出
  - MCP stdio 模式下 stdout 是协议通道，任何日志写到 stdout 都会破坏协议
  C# 对照：≈ 在 ConfigureLogging 里配置 AddConsole(o => o.LogToStandardErrorThreshold = LogLevel.Trace)
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="com.lee.prreviewer" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
